@echo off
chcp 65001 > nul
title أمانة عمّان الكبرى - توليد رابط مشاركة عام عبر الإنترنت

echo ============================================================
echo   🇯🇴 أمانة عمّان الكبرى - قسم المخالفات
echo   توليد رابط عام فوري وآمن (HTTPS) لمشاركة النظام عبر الإنترنت
echo ============================================================
echo.
echo [1/2] جاري تشغيل الخادم في الخلفية...

cd /d "%~dp0"
start "" /b node server/src/server.js

timeout /t 2 > nul

echo [2/2] جاري إنشاء نفق اتصال آمن وتوليد الرابط العام...
echo.
echo ============================================================
echo ستحصل الآن على رابط خارجي (مثال: https://xxxx.loca.lt)
echo انسخه وأرسله للشخص المعني في أمانة عمّان لتجربة النظام فوراً!
echo ============================================================
echo.

npx localtunnel --port 5000
pause
