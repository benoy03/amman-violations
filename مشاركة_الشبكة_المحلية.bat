@echo off
chcp 65001 > nul
title أمانة عمّان الكبرى - مشاركة النظام عبر الشبكة الداخلية

echo ============================================================
echo   🇯🇴 أمانة عمّان الكبرى - قسم المخالفات
echo   مشاركة النظام مع الزملاء على شبكة المكتب (LAN / Wi-Fi)
echo ============================================================
echo.

cd /d "%~dp0"

for /f "tokens=4" %%a in ('route print ^| findstr 0.0.0.0 ^| findstr /v "0.0.0.0.0"') do set IP=%%a

echo [معلومات الاتصال بالشبكة]:
echo عنوان الجهاز على شبكة الأمانة: %IP%
echo.
echo ============================================================
echo 📢 يمكن لأي زميل في مكتب قسم المخالفات فتح الرابط التالي
echo    من جهازه أو هاتفه المحمول المتصل بنفس الشبكة:
echo.
echo    👉  http://%IP%:5000
echo.
echo ============================================================
echo.

node server/src/server.js
pause
