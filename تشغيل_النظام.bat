@echo off
chcp 65001 > nul
title أمانة عمّان الكبرى - نظام تعديل مخالفات الكاميرات

echo ============================================================
echo   🇯🇴 أمانة عمّان الكبرى - مديرية الرقابة الآلية
echo   نظام كشف وتعديل مخالفات الكاميرات الرقابية (قسم المخالفات)
echo ============================================================
echo.
echo [1/3] جاري فحص بيئة العمل والتشغيل...

cd /d "%~dp0"

where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [خطأ] Node.js غير مثبت على هذا الجهاز. يرجى تثبيته من موقع nodejs.org
    pause
    exit /b
)

echo [2/3] جاري بدء تشغيل خادم أمانة عمّان...
start "" /b node server/src/server.js

echo [3/3] جاري فتح واجهة النظام في المتصفح...
timeout /t 2 > nul
start http://localhost:5000

echo.
echo ============================================================
echo   ✅ النظام يعمل الآن بنجاح على الرابط: http://localhost:5000
echo   بيانات الدخول:
echo   - مدير النظام:  admin / admin123
echo   - موظف الرقابة: user / user123
echo ============================================================
echo   (اترك هذه النافذة مفتوحة طوال فترة استخدام النظام)
echo.
pause
